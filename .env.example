# ============================================================
# AI Blog Automation - 환경 변수
# 이 파일을 .env로 복사한 후 실제 값을 입력하세요
# cp .env.example .env
# ============================================================

# ── Anthropic (Claude API) ──
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# ── Tistory API ──
TISTORY_APP_ID=your-app-id
TISTORY_SECRET_KEY=your-secret-key
TISTORY_ACCESS_TOKEN=your-access-token
TISTORY_BLOG_NAME=your-blog-name

# ── Naver API (데이터랩, 검색) ──
NAVER_CLIENT_ID=your-client-id
NAVER_CLIENT_SECRET=your-client-secret

# ── n8n ──
N8N_USER=admin
N8N_PASSWORD=your-secure-password

# ── Database ──
DATABASE_URL=sqlite:///data/blog.db

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── Image Generation (테스트 후 결정) ──
# OPENAI_API_KEY=sk-your-key      # DALL-E 3 사용 시
# STABILITY_API_KEY=your-key       # Stable Diffusion 사용 시
